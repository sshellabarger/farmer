# Copy to .env for local development. Every variable the app reads is listed
# here and validated in src/config/env.ts. Never commit .env.
#
# src/config/env.ts loads this file WITHOUT override: a value already in the
# process environment (tests, CI, Cloud Functions) always wins.

# ─── Test mode (SPEC §7.3) ───────────────────────────────────────────────────
# The console providers print every text/email to the log and record texts in
# `messages` as status=simulated. Nothing leaves the machine.
#
# The real providers (voip.ms, Resend) are reachable ONLY when BOTH
#   NODE_ENV=production  and  ALLOW_REAL_SENDS=true
# Any other combination makes sendSms/sendEmail throw SendsDisabledError
# before a single byte is written or sent. A dev machine keeps these three
# lines as they are; the production values live in .env.arkansaslocalfoodnetwork,
# which the Firebase CLI reads only at deploy time (see below).
SMS_PROVIDER=console
EMAIL_PROVIDER=console
ALLOW_REAL_SENDS=false

# ─── SMS: voip.ms (the only real provider) ──────────────────────────────────
VOIPMS_USERNAME=
VOIPMS_PASSWORD=
# The sending DID, 10 digits, no +1
VOIPMS_DID=5555555555
# Shared secret guarding the inbound callback (voip.ms cannot sign callbacks).
# ACTIVATION ORDER MATTERS:
#   1. In the voip.ms portal set the SMS callback URL to
#      https://<host>/api/sms/voipms/inbound?secret=<value>
#   2. Only then set VOIPMS_WEBHOOK_SECRET=<value> here and redeploy.
# Setting the variable first rejects every inbound text until the portal
# URL carries the secret. Blank = accept everything and log a warning.
VOIPMS_WEBHOOK_SECRET=

# ─── Email: Resend ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender. Blank makes email sends fail loudly (no org default).
FROM_EMAIL=

# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL used in texted links
APP_URL=http://localhost:3001
# Local dev server port/host (Cloud Functions sets PORT itself; do not use PORT)
LOCAL_PORT=3000
HOST=0.0.0.0
# development | production | test. 'development' accepts any 6-digit OTP.
NODE_ENV=development
# HS256 secret for login JWTs (7-day expiry). Rotating it logs everyone out.
JWT_SECRET=change_me_in_production

# ─── Anthropic (error alerts only) ──────────────────────────────────────────
# Used solely by src/services/error-notify.ts to draft a fix suggestion for
# alert emails/texts. There is no AI assistant in the app.
ANTHROPIC_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────
# Firebase Storage bucket for image uploads (logos, booth photos). Blank makes
# uploads fail rather than target a bucket by accident.
STORAGE_BUCKET=

# ─── Error alerts ───────────────────────────────────────────────────────────
# Where 5xx errors and scheduler failures are texted/emailed (throttled to one
# per error signature per 30 min). Blank disables that channel.
ALERT_EMAIL=
ALERT_PHONE=

# ─── Production (deploy-time only) ──────────────────────────────────────────
# The Firebase CLI reads .env.<project-id> when deploying functions to that
# project; npm run dev never loads it. Put ONLY the production switches there
# so the dev machine stays on console providers:
#
#   # .env.arkansaslocalfoodnetwork
#   NODE_ENV=production
#   ALLOW_REAL_SENDS=true
#   SMS_PROVIDER=voipms
#   EMAIL_PROVIDER=resend
#
# Without them the deployed functions run the console provider: OTP logins,
# reminders and broadcasts are logged as `simulated` and nothing reaches
# voip.ms or Resend. GET /api/admin/providers (as admin) shows what is live.

# ─── Firebase (usually not needed) ──────────────────────────────────────────
# Cloud Functions set FIREBASE_CONFIG and GCLOUD_PROJECT automatically and the
# admin SDK uses application-default credentials. Locally, either run
# `gcloud auth application-default login` or point GOOGLE_APPLICATION_CREDENTIALS
# at a service-account key kept OUTSIDE the repo.
# GCLOUD_PROJECT=arkansaslocalfoodnetwork
# FIREBASE_CONFIG={"projectId":"arkansaslocalfoodnetwork","storageBucket":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/service-account.json
