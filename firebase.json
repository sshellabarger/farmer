{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "web",
        ".git",
        "uploads",
        ".env",
        ".env.*",
        "service-account.json",
        "*service-account*.json",
        ".claude",
        ".firebase",
        "export",
        "docs",
        "tests",
        "*.md",
        "*.svg",
        "*.jsx",
        "*.html",
        ".DS_Store"
      ]
    }
  ],
  "hosting": {
    "source": "web",
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "512MiB"
    },
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
