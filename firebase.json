{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "web",
        ".git",
        "uploads",
        ".env",
        ".env.*",
        "service-account.json",
        "*service-account*.json",
        ".claude",
        ".firebase",
        ".github",
        "docs",
        "tests",
        "archive",
        "src",
        "scripts",
        "*.md",
        "*.svg",
        "*.jsx",
        "*.mp4",
        ".DS_Store",
        "tsconfig.json",
        "vitest.config.ts"
      ]
    }
  ],
  "hosting": {
    "source": "web",
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "512MiB"
    },
    "redirects": [
      { "source": "/farmer", "destination": "/changed", "type": 301 },
      { "source": "/market", "destination": "/changed", "type": 301 },
      { "source": "/upload-photo", "destination": "/changed", "type": 301 },
      { "source": "/signup", "destination": "/changed", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
